# 로컬 개발용 환경변수 템플릿.
# 사용법: 이 파일을 .env.local 로 복사한 뒤 그대로 사용하면 된다 (값 전부 더미/자리값,
# 실제 시크릿 아님). .env.local 은 .gitignore 처리되어 있어 각자 로컬에만 존재한다.
#
#   cp .env.example .env.local
#
# 값이 없으면 무슨 일이 나는지는 각 항목 주석 참고.

# ── Keycloak / NextAuth ──────────────────────────────────────
# 값이 없으면 auth.ts 의 getAuthOptions() 가 즉시 throw('Missing Keycloak
# configuration')해서 (with-session), (with-role) 레이아웃을 쓰는 모든 페이지가
# 500 에러로 깨진다. 실제 로그인은 안 되지만(가짜 서버 주소), 크래시만 막는 용도.
KEYCLOAK_CLIENT_ID=local-dev-placeholder
KEYCLOAK_CLIENT_SECRET=local-dev-placeholder
KEYCLOAK_ISSUER=http://localhost:8080/realms/uoslife
NEXTAUTH_SECRET=local-dev-secret-not-for-prod
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/uoslife

# ── Analytics ─────────────────────────────────────────────────
# 값이 없으면 entities/analytics/useAnalytics.tsx 가 useEffect 안에서 throw 해서
# 화면 전체(AnalyticsContextProvider 상위)가 깨진다.
NEXT_PUBLIC_AMPLITUDE_API_KEY=local-dev-placeholder
NEXT_PUBLIC_GA4_TRACKING_ID=G-LOCALDEV00

# ── 목로그인 / 네트워크 격리 ──────────────────────────────────
# 값이 없으면 api-instance.ts 의 axios baseURL 이 실제 프로덕션
# (https://about-api.uoslife.com) 으로 폴백한다. 존재하지 않는 로컬 포트로 돌려
# MSW 목킹이 놓친 요청도 프로덕션에 새어나가지 않도록 이중 방어한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:9999/
# true 일 때만 auth.ts 에 목업 로그인 provider 가 추가되고, MSW(src/mocks)가 시작된다.
NEXT_PUBLIC_ENABLE_MOCK=true
