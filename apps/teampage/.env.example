# 이 파일을 .env.local 로 복사한 뒤 빈 값을 채우세요 (.env.local 은 커밋되지 않습니다).

# A/B 테스트 설정 저장소 (S3)
# FLAGS_ENV 는 alpha 로 두세요. prod 로 두면 로컬에서 프로덕션 실험 설정을 건드립니다.
FLAGS_ENV=alpha
FLAGS_BUCKET=uoslife-v2026--flags
AWS_REGION=ap-northeast-2

# IAM 사용자 uoslife-about-client-dev 의 액세스 키.
# 발급: aws iam create-access-key --user-name uoslife-about-client-dev --profile uoslife-production
# 권한은 public/private v1/alpha.json 에 대한 읽기·쓰기뿐입니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
